#include <intelblocks/tcss.h>

chip soc/intel/meteorlake
	# GPE0 banks as the vendor firmware routes them: GPP_B, the virtual USB
	# group and the virtual LPC group. The LPC group carries the one GPE event the ACPI handles.
	register "pmc_gpe0_dw0" = "PMC_GPP_B"
	register "pmc_gpe0_dw1" = "PMC_GPP_VGPIO_USB"
	register "pmc_gpe0_dw2" = "PMC_GPP_VGPIO_LPC"

	# The vendor firmware leaves chipset I2C0 and I2C2 enabled in PCI mode (80:15.0 and
	# 80:15.2). With every Serial IO controller off, FSP-S changes the chipset
	# function-disable bits and leaves a global reset pending, which ended every first boot.
	register "serial_io_i2c_mode" = "{
		[PchSerialIoIndexI2C0] = PchSerialIoPci,
		[PchSerialIoIndexI2C2] = PchSerialIoPci,
	}"


	# USB2 ports 1 to 14 and USB3 ports 1 to 9 of the chipset xHCI. The overcurrent pins and the
	# PHY tuning are not known, so every port uses the medium-length defaults with no overcurrent pin.
	register "usb2_ports[0]" = "USB2_PORT_MID(OC_SKIP)" # port 1, hotplug
	register "usb2_ports[1]" = "USB2_PORT_MID(OC_SKIP)" # port 2, hardwired
	register "usb2_ports[2]" = "USB2_PORT_MID(OC_SKIP)" # port 3, hotplug
	register "usb2_ports[3]" = "USB2_PORT_MID(OC_SKIP)" # port 4, hotplug
	register "usb2_ports[4]" = "USB2_PORT_MID(OC_SKIP)" # port 5, hotplug
	register "usb2_ports[5]" = "USB2_PORT_MID(OC_SKIP)" # port 6, hotplug
	register "usb2_ports[6]" = "USB2_PORT_MID(OC_SKIP)" # port 7, hotplug
	register "usb2_ports[7]" = "USB2_PORT_MID(OC_SKIP)" # port 8, hotplug
	register "usb2_ports[8]" = "USB2_PORT_MID(OC_SKIP)" # port 9, hotplug
	register "usb2_ports[9]" = "USB2_PORT_MID(OC_SKIP)" # port 10, hardwired
	register "usb2_ports[10]" = "USB2_PORT_MID(OC_SKIP)" # port 11, hotplug
	register "usb2_ports[11]" = "USB2_PORT_MID(OC_SKIP)" # port 12, hotplug
	register "usb2_ports[12]" = "USB2_PORT_MID(OC_SKIP)" # port 13, marked unused by ACPI, but an ASRock LED controller is attached
	register "usb2_ports[13]" = "USB2_PORT_MID(OC_SKIP)" # port 14, hardwired
	register "usb3_ports[0]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 1, hotplug
	register "usb3_ports[1]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 2, hotplug
	register "usb3_ports[2]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 3, hotplug
	register "usb3_ports[3]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 4, hotplug
	register "usb3_ports[4]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 5, hotplug
	register "usb3_ports[5]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 6, hotplug
	register "usb3_ports[6]" = "USB3_PORT_EMPTY" # port 7, marked unused by ACPI
	register "usb3_ports[7]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 8, hotplug
	register "usb3_ports[8]" = "USB3_PORT_DEFAULT(OC_SKIP)" # port 9, hotplug

	device domain 0 on
		device ref system_agent on end
		device ref igpu on end

		# The DPTF root device and the CPU participant. The vendor firmware defines more
		# participants, but only the CPU and its trip points work: its fan participant's
		# status method fails on the running board, because the fans are the EC's.
		device ref dtt on
			chip drivers/intel/dptf
				# The vendor trips are all at or above the 105 degree Tj max, so they are
				# a last resort: critical, hot and passive at 110 degrees.
				register "policies.passive" = "{
					[0] = DPTF_PASSIVE(CPU, CPU, 110, 10000),
				}"
				register "policies.critical" = "{
					[0] = DPTF_CRITICAL(CPU, 110, SHUTDOWN),
				}"
				device generic 0 alias dptf_policy on end
			end
		end

		# Crash log: the SoC PMC's records are read through this SRAM's BAR.
		device ref soc_shared_sram on end

		# The vendor firmware's ACPI puts the LPC bridge, the Super I/O and the EC under the
		# SoC's root bridge, and both eSPI controllers decode the same ranges, so the Super I/O
		# and the TPM hang off the SoC's controller here.
		device ref soc_espi on
			# NCT6686D.
			chip superio/nuvoton/nct6687d
				# Values are what the vendor firmware leaves in the EC after PEI with the default
				# setup: monitor slots, fan pin routing and the Smart Fan IV curves.
				register "sensors[0]" = "PECI_AGENT0_DOMAIN0"
				register "sensors[1]" = "THERMISTOR14"
				register "sensors[2]" = "THERMISTOR15"
				register "sensors[3]" = "THERMISTOR5"
				register "sensors[4]" = "VIN16"
				register "sensors[5]" = "VIN0"
				register "sensors[6]" = "VIN1"
				register "sensors[7]" = "VIN2"
				register "sensors[8]" = "VIN3"
				register "sensors[9]" = "VIN6"
				register "sensors[10]" = "VIN7"
				register "sensors[11]" = "VCC"
				register "sensors[12]" = "VBAT"

				register "fan_default_val" = "50"

				# CPU_FAN1, inferred from the vendor Setup block order
				register "FAN1.mode" = "FAN_SMART_FAN_IV"
				register "FAN1.unit_sel" = "FAN_PWM"
				register "FAN1.fanin_sel" = "TACH_PWM9"
				register "FAN1.fanout_sel" = "TACH_PWM10"
				register "FAN1.fan_alg_weight" = "10"
				register "FAN1.smart_fan.temp_src" = "{ 1, 0, 0, 0 }"
				register "FAN1.smart_fan.temp_levels" = "{ 40, 65, 70, 70, 115, 115, 115 }"
				register "FAN1.smart_fan.speed_levels" = "{ 20, 70, 100, 100, 100, 100, 100 }"

				# CHA_FAN3, inferred from the vendor Setup block order
				register "FAN2.mode" = "FAN_SMART_FAN_IV"
				register "FAN2.unit_sel" = "FAN_PWM"
				register "FAN2.fanin_sel" = "TACH_PWM11"
				register "FAN2.fanout_sel" = "TACH_PWM12"
				register "FAN2.fan_alg_weight" = "10"
				register "FAN2.smart_fan.temp_src" = "{ 2, 0, 0, 0 }"
				register "FAN2.smart_fan.temp_levels" = "{ 40, 70, 70, 70, 115, 115, 115 }"
				register "FAN2.smart_fan.speed_levels" = "{ 60, 100, 100, 100, 100, 100, 100 }"

				# CPU_FAN2, inferred from the vendor Setup block order
				register "FAN3.mode" = "FAN_SMART_FAN_IV"
				register "FAN3.unit_sel" = "FAN_PWM"
				register "FAN3.fanin_sel" = "TACH_PWM5"
				register "FAN3.fanout_sel" = "TACH_PWM6"
				register "FAN3.fan_alg_weight" = "10"
				register "FAN3.smart_fan.temp_src" = "{ 1, 0, 0, 0 }"
				register "FAN3.smart_fan.temp_levels" = "{ 40, 65, 70, 70, 115, 115, 115 }"
				register "FAN3.smart_fan.speed_levels" = "{ 20, 70, 100, 100, 100, 100, 100 }"

				# CHA_FAN1, inferred from the vendor Setup block order
				register "FAN4.mode" = "FAN_SMART_FAN_IV"
				register "FAN4.unit_sel" = "FAN_PWM"
				register "FAN4.fanin_sel" = "TACH_PWM7"
				register "FAN4.fanout_sel" = "TACH_PWM8"
				register "FAN4.fan_alg_weight" = "10"
				register "FAN4.smart_fan.temp_src" = "{ 2, 0, 0, 0 }"
				register "FAN4.smart_fan.temp_levels" = "{ 40, 70, 70, 70, 115, 115, 115 }"
				register "FAN4.smart_fan.speed_levels" = "{ 60, 100, 100, 100, 100, 100, 100 }"

				# CHA_FAN2, inferred from the vendor Setup block order
				register "FAN5.mode" = "FAN_SMART_FAN_IV"
				register "FAN5.unit_sel" = "FAN_PWM"
				register "FAN5.fanin_sel" = "TACH_PWM2"
				register "FAN5.fanout_sel" = "TACH_PWM3"
				register "FAN5.fan_alg_weight" = "10"
				register "FAN5.smart_fan.temp_src" = "{ 2, 0, 0, 0 }"
				register "FAN5.smart_fan.temp_levels" = "{ 40, 70, 70, 70, 115, 115, 115 }"
				register "FAN5.smart_fan.speed_levels" = "{ 60, 100, 100, 100, 100, 100, 100 }"

				# CHA_FAN4, inferred from the vendor Setup block order
				register "FAN6.mode" = "FAN_SMART_FAN_IV"
				register "FAN6.unit_sel" = "FAN_PWM"
				register "FAN6.fanin_sel" = "TACH_PWM22"
				register "FAN6.fanout_sel" = "TACH_PWM23"
				register "FAN6.fan_alg_weight" = "10"
				register "FAN6.smart_fan.temp_src" = "{ 2, 0, 0, 0 }"
				register "FAN6.smart_fan.temp_levels" = "{ 40, 70, 70, 70, 115, 115, 115 }"
				register "FAN6.smart_fan.speed_levels" = "{ 60, 100, 100, 100, 100, 100, 100 }"

				# CHA_FAN5, inferred from the vendor Setup block order
				register "FAN7.mode" = "FAN_SMART_FAN_IV"
				register "FAN7.unit_sel" = "FAN_PWM"
				register "FAN7.fanin_sel" = "TACH_PWM0"
				register "FAN7.fanout_sel" = "TACH_PWM1"
				register "FAN7.fan_alg_weight" = "10"
				register "FAN7.smart_fan.temp_src" = "{ 2, 0, 0, 0 }"
				register "FAN7.smart_fan.temp_levels" = "{ 40, 70, 70, 70, 115, 115, 115 }"
				register "FAN7.smart_fan.speed_levels" = "{ 60, 100, 100, 100, 100, 100, 100 }"

				# AIO_PUMP, inferred from the vendor Setup block order
				register "FAN8.mode" = "FAN_SMART_FAN_IV"
				register "FAN8.unit_sel" = "FAN_PWM"
				register "FAN8.fanin_sel" = "TACH_PWM16"
				register "FAN8.fanout_sel" = "TACH_PWM17"
				register "FAN8.fan_alg_weight" = "10"
				register "FAN8.smart_fan.temp_src" = "{ 1, 0, 0, 0 }"
				register "FAN8.smart_fan.temp_levels" = "{ 0, 0, 0, 0, 0, 0, 0 }"
				register "FAN8.smart_fan.speed_levels" = "{ 100, 100, 100, 100, 100, 100, 100 }"

				# Every logical device is listed, with the state the vendor firmware leaves. An
				# unlisted one would be enabled by the PNP code, which sets bit 0 of CR30, and on
				# this chip CR30 is not an enable bit everywhere: on LDN 0x0d it is Deep S5 enable,
				# on 0x0c RTC enable, both battery-backed (NCT6686D datasheet 18.12, 18.13). "off"
				# clears only bit 0, which the vendor leaves clear on those, so they keep the vendor
				# values (0x0d: 0xa0).
				device pnp 2e.1 off end		# parallel port
				device pnp 2e.2 off end		# UART A
				device pnp 2e.3 off end		# UART B, IR
				device pnp 2e.5 on		# keyboard controller
					io 0x60 = 0x60
					io 0x62 = 0x64
					irq 0x70 = 1
					irq 0x72 = 12
				end
				device pnp 2e.6 off end		# CIR
				device pnp 2e.7 off end		# GPIO0-7: CR30 is per-group host access, 0x00
				device pnp 2e.8 on end		# PORT80 UART: no CR30, reads 0xff and is written back
				device pnp 2e.9 off end		# GPIO8-9, alternate functions: CR30 0x00
				# ACPI: the vendor leaves CR60/61 at 0 (reset value, LRESET#); no io line here
				# so coreboot leaves them too, and lpc_open_pmio_window() is not asked to
				# open a window at I/O 0 ("LPC IO decode base 0!").
				device pnp 2e.a on
					irq 0x70 = 0x40
				end
				device pnp 2e.b on		# EC space
					io 0x60 = 0xa20
				end
				device pnp 2e.c off end		# RTC timer: CR30 is RTC configuration, 0x00
				device pnp 2e.d off end		# Deep sleep, power fault: CR30 0xa0, Deep S5 off
				device pnp 2e.e on end		# TACHIN/PWMOUT assignment: no CR30
				device pnp 2e.f on end		# function registers: no CR30
			end

			# TPM module on the SPI TPM header, memory mapped at 0xfed40000. The interrupt
			# pin is not known, so the driver polls.
			chip drivers/pc80/tpm
				device pnp 0.0 on end
			end
		end
	end

	device domain 1 on
		device ref heci1 on end
		device ref i2c0 on end
		device ref i2c2 on end
		# CnviMode 1 (Auto), as the vendor leaves it: with no CNVi radio module FSP-S then only
		# hides the function. CnviMode 0 makes FSP-S set its function-disable bit, which the
		# vendor leaves clear, and queue a global reset. The Wi-Fi card is a discrete AX210 on
		# a root port.
		device ref cnvi_wifi on end
		# The two chipset root ports in use: 80:1c.0 (port 3, RTL8125 LAN) and 80:1c.3 (port 4,
		# AX210 Wi-Fi). Left off, coreboot neither numbers their buses nor gives them windows
		# ("bridge configuration invalid ([bus 00-00])" in Linux), and the OS-assigned windows
		# at 0xb8000000 do not reach the cards.
		device ref pcie_rp1 on end
		device ref pcie_rp4 on end
		device ref xhci on
			chip drivers/usb/acpi
				device ref xhci_root_hub on
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port1 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port2 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port3 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port4 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port5 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port6 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port7 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port8 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port9 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port10 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port11 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_A"
						device ref usb2_port12 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port13 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port14 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port1 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port2 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port3 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port4 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port5 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port6 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port8 on end
					end
					chip drivers/usb/acpi
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb3_port9 on end
					end
				end
			end
		end
		device ref pch_espi on
			register "gen1_dec" = "LPC_IO(0xa00, 0x40)"
		end
	end
end
